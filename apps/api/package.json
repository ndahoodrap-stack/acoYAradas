{
  "name": "@acoyaradas/api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "esbuild src/server.ts --bundle --packages=external --alias:@acoyaradas/shared=../../packages/shared/src/index.ts --platform=node --target=node20 --format=esm --outfile=dist/server.js",
    "migrate": "tsx src/db/migrate.ts",
    "reset": "tsx src/db/migrate.ts --reset",
    "seed": "tsx src/db/seed.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@acoyaradas/shared": "*",
    "@electric-sql/pglite": "^0.2.17",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "pg": "^8.13.1",
    "vite": "8.3.5",
    "vitest": "4.1.12",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/pg": "^8.11.10",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
