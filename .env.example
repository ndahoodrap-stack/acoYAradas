# ---------------------------------------------------------------------------
# acoYAradas! - variables de entorno
# Copiar a .env y completar. NUNCA subir .env al repositorio.
# ---------------------------------------------------------------------------

# Servidor
NODE_ENV=production
PORT=3001
TRUST_PROXY=true
PUBLIC_BASE_URL=https://tu-dominio.com

# Orígenes permitidos para el frontend (separados por coma).
# Si el frontend se sirve desde el mismo dominio que la API, no hace falta
# agregar nada más. Si usás Vercel + API en otro dominio, poné el de Vercel.
CORS_ORIGINS=https://tu-dominio.com,https://www.tu-dominio.com

# Datos de contacto públicos
CONTACT_EMAIL=hola@acoyaradas.app
CONTACT_PHONE=+54 9 2284 55-5555
COVERAGE_TEXT=Cobertura exclusiva en San Carlos de Bolívar, Provincia de Buenos Aires.
HOURS_TEXT=Lunes a sábado de 9:00 a 21:00 h

# --- Base de datos ---------------------------------------------------------
# Producción: SIEMPRE Supabase/Postgres. "local" usa PGlite en disco y se
# pierde al reiniciar el servicio en la nube.
DB_MODE=supabase
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# --- Autenticación ---------------------------------------------------------
# local  = JWT propio (tabla local_users), no requiere Supabase Auth.
# supabase = delega login/registro en Supabase Auth.
AUTH_MODE=local
# OBLIGATORIO en producción. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=cambiar-por-una-clave-larga-y-aleatoria
ACCESS_TOKEN_TTL=7200
REFRESH_TOKEN_TTL=2592000

# --- Supabase (storage de imágenes y auth, si se usa) ----------------------
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_STORAGE_BUCKET=public

# --- WhatsApp --------------------------------------------------------------
# links = genera enlaces wa.me (recomendado para empezar).
# none  = sólo registra notificaciones en la base.
WHATSAPP_PROVIDER=links
WHATSAPP_OWNER_PHONE=5492284555555
WHATSAPP_AUTO_OPEN=true
WHATSAPP_AUTO_SEND=false

# --- Uploads (fallback local) ---------------------------------------------
# En la nube el disco es efímero: usar Supabase Storage.
UPLOADS_DIR=./uploads
