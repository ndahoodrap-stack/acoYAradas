{
  "name": "acoyaradas",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "acoYAradas! - Marketplace de comercios, publicidad, compras online y motomandados (AR)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @acoyaradas/api",
    "dev:web": "npm run dev -w @acoyaradas/web",
    "build": "npm run build -w @acoyaradas/api && npm run build -w @acoyaradas/web",
    "start": "npm run start -w @acoyaradas/api",
    "preview": "npm run preview -w @acoyaradas/web",
    "db:migrate": "npm run migrate -w @acoyaradas/api",
    "db:reset": "npm run reset -w @acoyaradas/api",
    "db:seed": "npm run seed -w @acoyaradas/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^20.17.9",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "esbuild": "0.28.2",
    "vite": "8.3.5"
  }
}
